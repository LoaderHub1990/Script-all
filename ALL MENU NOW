local RGBSpeed = 0.005
local isRGBRunning = false
local rgbConnection = nil
local currentHue = 0
local TryOn = ReplicatedStorage:WaitForChild("Catalog"):WaitForChild("TryOn")

local function startRGB()
    if rgbConnection then
        rgbConnection:Disconnect()
        rgbConnection = nil
    end
    
    isRGBRunning = true
    currentHue = 0
    
    rgbConnection = RunService.RenderStepped:Connect(function()
        if not isRGBRunning then return end
        
        currentHue = (currentHue + RGBSpeed) % 1
        local color = Color3.fromHSV(currentHue, 1, 1)
        
        local args = { color }
        pcall(function()
            TryOn:InvokeServer(unpack(args))
        end)
    end)
    
    WindUI:Notify({
        Title = "🌈 RGB Started",
        Content = "Speed: " .. string.format("%.3f", RGBSpeed),
        Duration = 2
    })
end

local function stopRGB()
    isRGBRunning = false
    if rgbConnection then
        rgbConnection:Disconnect()
        rgbConnection = nil
    end
    
    WindUI:Notify({
        Title = "🛑 RGB Stopped",
        Content = "หยุดเปลี่ยนสีแล้ว",
        Duration = 2
    })
end

