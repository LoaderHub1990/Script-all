local buttons = {}

local function makeButton(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -28, 0, 36)
	b.Position = UDim2.new(0, 14, 0, y)
	b.BackgroundColor3 = DARK
	b.Font = FONT_BOLD
	b.TextSize = 15
	b.TextColor3 = WHITE
	b.Text = text
	b.AutoButtonColor = false
	b.Parent = frame
	round(b, 8)

	local s = stroke(b, 1.5)

	buttons[b] = {
		stroke = s,
		enabled = true
	}

	b.MouseEnter:Connect(function()
		if buttons[b].enabled then
			TweenService:Create(
				b,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = WHITE,
					TextColor3 = BLACK
				}
			):Play()
		end
	end)

	b.MouseLeave:Connect(function()
		if buttons[b].enabled then
			TweenService:Create(
				b,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = DARK,
					TextColor3 = WHITE
				}
			):Play()
		end
	end)

	return b
end

local function setEnabled(btn, on)
	buttons[btn].enabled = on
	btn.BackgroundColor3 = DARK
	btn.TextColor3 = on and WHITE or GRAY
	buttons[btn].stroke.Color = on and WHITE or GRAY
end

