local function setUIOpen(open)
    uiOpen = open

    if open then
        frame.Visible = true

        frame.Size = UDim2.fromOffset(0, 0)

        frame.Position = UDim2.new(
            0.5,
            0,
            0.5,
            0
        )

        tween(
            frame,
            {
                Size = UDim2.fromOffset(
                    340,
                    315
                ),

                Position = UDim2.new(
                    0.5,
                    -170,
                    0.5,
                    -157
                )
            },
            0.35,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        )
    else
        tween(
            frame,
            {
                Size = UDim2.fromOffset(
                    0,
                    0
                ),

                Position = UDim2.new(
                    0.5,
                    0,
                    0.5,
                    0
                )
            },
            0.25,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        )

        task.delay(0.27, function()
            if not uiOpen then
                frame.Visible = false
            end
        end)
    end
end

