playBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        pcall(function()
            playRemote:FireServer(
                "ToolMusicText",
                "",
                nil,
                true
            )
        end)

        setPlaying(false)
        currentId = ""

        return
    end

    local rawId = inputBox.Text:gsub("%D", "")

    if rawId == "" then
        tween(
            inputStroke,
            {
                Color = C.red
            },
            0.1
        )

        task.wait(0.5)

        tween(
            inputStroke,
            {
                Color = C.border
            },
            0.2
        )

        return
    end

    currentId = rawId
    playBtn.Text = "⏳  LOADING..."

    task.spawn(function()
        local name = fetchSongName(rawId)

        PlayMusic(rawId)

        setPlaying(
            true,
            name or rawId
        )
    end)
end)

