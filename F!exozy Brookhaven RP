local function tween(obj, props, duration, style, direction)
    TweenService:Create(
        obj,
        TweenInfo.new(
            duration or 0.2,
            style or Enum.EasingStyle.Quad,
            direction or Enum.EasingDirection.Out
        ),
        props
    ):Play()
end

local function startPulse()
    if pulseConn then
        pulseConn:Disconnect()
    end

    local t = 0

    pulseConn = RunService.Heartbeat:Connect(function(dt)
        t += dt

        noteIcon.TextTransparency =
            0.05 + math.abs(math.sin(t * 3)) * 0.25

        if math.floor(t * 2) % 2 == 0 then
            noteIcon.Text = "♪"
        else
            noteIcon.Text = "♫"
        end
    end)
end

local function stopPulse()
    if pulseConn then
        pulseConn:Disconnect()
        pulseConn = nil
    end

    noteIcon.Text = "♪"
    noteIcon.TextTransparency = 0
end

local function formatTime(seconds)
    local minutes = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)

    return string.format(
        "%02d:%02d",
        minutes,
        secs
    )
end

local function startTimer()
    playStartTick = tick()

    if timerConn then
        timerConn:Disconnect()
    end

    timerConn = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - playStartTick

        timerLabel.Text = formatTime(elapsed)

        local percent = math.min(
            elapsed / 300,
            1
        )

        progressBg.Size = UDim2.new(
            percent,
            0,
            1,
            0
        )
    end)
end

local function stopTimer()
    if timerConn then
        timerConn:Disconnect()
        timerConn = nil
    end

    timerLabel.Text = "00:00"

    progressBg.Size = UDim2.new(
        0,
        0,
        1,
        0
    )
end

local function setPlaying(enabled, songName)
    isPlaying = enabled

    if enabled then
        playBtn.Text = "■  หยุดเพลง"

        songLabel.Text = songName or "กำลังโหลด..."
        songLabel.TextColor3 = C.text

        startPulse()
        startTimer()

        tween(
            songStroke,
            {
                Color = C.blue
            },
            0.2
        )
    else
        playBtn.Text = "▶  PLAY"

        songLabel.Text = "หยุดเพลง"
        songLabel.TextColor3 = C.textLight

        stopPulse()
        stopTimer()

        tween(
            songStroke,
            {
                Color = C.border
            },
            0.2
        )
    end
end

