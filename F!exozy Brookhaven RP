RunService.Heartbeat:Connect(function(dt)
    colorTime += dt

    local wave = (math.sin(colorTime * 1.5) + 1) / 2

    local animatedBlue = C.blue:Lerp(
        C.blueLight,
        wave
    )

    frameStroke.Color = animatedBlue
    toggleStroke.Color = animatedBlue
    playStroke.Color = animatedBlue

    noteIcon.TextColor3 = animatedBlue
end)

frame.Visible = false

task.delay(0.2, function()
    setUIOpen(true)
end)

