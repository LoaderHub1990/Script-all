        farmThread = nil
    end

    farmRow.btn.Text = "START"

    tween(farmRow.btn, 0.15, {
        BackgroundColor3 = BLUE
    }):Play()

    farmRow.dot.BackgroundColor3 =
        Color3.fromRGB(70, 95, 115)

    farmRow.lbl.TextColor3 = WHITE
    farmRow.desc.Text = "Auto farm gold"
    farmRow.desc.TextColor3 =
        Color3.fromRGB(145, 180, 205)

    refreshStatus()

    notify("Auto Farm stopped")
end

local function startFarm()

    cfg.farmActive = true
    cfg.farmCancelled = false

    farmRow.btn.Text = "STOP"

    tween(farmRow.btn, 0.15, {
        BackgroundColor3 = Color3.fromRGB(40, 105, 165)
    }):Play()

    farmRow.dot.BackgroundColor3 = GREEN

    farmRow.lbl.TextColor3 =
        LIGHT_BLUE

    farmRow.desc.Text =
        "Farming..."

    farmRow.desc.TextColor3 =
        Color3.fromRGB(130, 210, 245)

    refreshStatus()

    notify("Auto Farm started")

    farmThread = task.spawn(function()

        while cfg.farmActive
            and not cfg.farmCancelled do

            local ok, err =
                pcall(doRun, notify)

            if not ok then

                notify(
                    "Error: " ..
                    tostring(err)
                )

                task.wait(3)
            end
        end
    end)
end

