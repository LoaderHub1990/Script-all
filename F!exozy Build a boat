local function refreshStatus()

    local parts = {}

    if cfg.farmActive then
        table.insert(parts, "Farm")
    end

    if cfg.antiAfk then
        table.insert(parts, "AntiAFK")
    end

    if #parts == 0 then

        statusTxt.Text = "IDLE"
        statusTxt.TextColor3 = Color3.fromRGB(170, 200, 220)
        statusDot.BackgroundColor3 = Color3.fromRGB(80, 100, 120)

    else

        statusTxt.Text = "RUNNING - " .. table.concat(parts, " + ")
        statusTxt.TextColor3 = LIGHT_BLUE
        statusDot.BackgroundColor3 = BLUE

        startDotPulse()
    end
end

