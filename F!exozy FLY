    obj.MouseEnter:Connect(function()
        TweenService:Create(
            obj,
            TweenInfo.new(0.12),
            {
                BackgroundColor3 = Color3.fromRGB(215, 242, 255)
            }
        ):Play()
    end)

    obj.MouseLeave:Connect(function()
        TweenService:Create(
            obj,
            TweenInfo.new(0.12),
            {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            }
        ):Play()
    end)

    obj.MouseButton1Down:Connect(function()
        TweenService:Create(
            obj,
            TweenInfo.new(0.08),
            {
                Size = UDim2.new(
                    obj.Size.X.Scale,
                    obj.Size.X.Offset - 2,
                    obj.Size.Y.Scale,
                    obj.Size.Y.Offset - 2
                )
            }
        ):Play()

        task.wait(0.08)

        TweenService:Create(
            obj,
            TweenInfo.new(0.08),
            {
                Size = UDim2.new(
                    obj.Size.X.Scale,
                    obj.Size.X.Offset + 2,
                    obj.Size.Y.Scale,
                    obj.Size.Y.Offset + 2
                )
            }
        ):Play()
    end)
end

