local function RefreshStatus()
    local Parts = {}
    if AutoSell then table.insert(Parts, "Auto Sell") end
    if AntiAfk then table.insert(Parts, "Anti AFK") end

    if #Parts == 0 then
        StatusText.Text = "IDLE"
        StatusText.TextColor3 = SUBTEXT
        StatusDot.BackgroundColor3 = Color3.fromRGB(75, 100, 120)
    else
        StatusText.Text = "RUNNING • " .. table.concat(Parts, " + ")
        StatusText.TextColor3 = LIGHT_BLUE
        StatusDot.BackgroundColor3 = GREEN
    end
end

local function StopAutoSell()
    AutoSell = false
    if LoopConnection then
        LoopConnection:Disconnect()
        LoopConnection = nil
    end
    Toggle.Text = "OFF"
    Tween(Toggle, 0.15, { BackgroundColor3 = Color3.fromRGB(25, 55, 78) }):Play()
    Toggle.TextColor3 = SUBTEXT
    CardDescription.Text = "เก็บเงินอัตโนมัติ"
    RefreshStatus()
end

local function StartAutoSell()
    AutoSell = true
    Toggle.Text = "ON"
    Tween(Toggle, 0.15, { BackgroundColor3 = BLUE }):Play()
    Toggle.TextColor3 = WHITE
    CardDescription.Text = "กำลังเก็บเงิน..."
    RefreshStatus()

    LoopConnection = RunService.Heartbeat:Connect(function()
        if not AutoSell then return end
        for i = 1, 20 do
            pcall(function()
                HouseEvent:FireServer("Sell")
            end)
        end
    end)
end

Toggle.MouseButton1Click:Connect(function()
    if AutoSell then
        StopAutoSell()
    else
        StartAutoSell()
    end
end)

