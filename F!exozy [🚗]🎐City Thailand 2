local function AddCorner(Object, Radius)
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, Radius)
    Corner.Parent = Object
    return Corner
end

local function AddStroke(Object, Color, Thickness, Transparency)
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color
    Stroke.Thickness = Thickness or 1
    Stroke.Transparency = Transparency or 0
    Stroke.Parent = Object
    return Stroke
end

local function Tween(Object, Time, Properties)
    return TweenService:Create(
        Object,
        TweenInfo.new(Time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        Properties
    )
end

local function CreateGradient(Object)
    local Gradient = Instance.new("UIGradient")
    Gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(185, 235, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(55, 170, 255)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(105, 215, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
    })
    Gradient.Rotation = 0
    Gradient.Parent = Object
    task.spawn(function()
        local Offset = 0
        while Gradient.Parent do
            Offset += 0.006
            if Offset >= 1 then Offset = 0 end
            Gradient.Offset = Vector2.new(Offset, 0)
            task.wait()
        end
    end)
    return Gradient
end

