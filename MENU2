-- ===== โหลดข้อมูลผู้ใช้ =====
local function loadUserData()
    task.spawn(function()
        local userId = Players.LocalPlayer.UserId
        pcall(function()
            local response = HttpService:GetAsync("https://users.roblox.com/v1/users/" .. userId)
            local data = HttpService:JSONDecode(response)
            if data and data.created then
                local createdDate = os.time({
                    year = tonumber(string.sub(data.created, 1, 4)),
                    month = tonumber(string.sub(data.created, 6, 7)),
                    day = tonumber(string.sub(data.created, 9, 10))
                })
                local now = os.time()
                local days = math.floor((now - createdDate) / 86400)
                stats.accountAge = days .. " วัน"
            end
        end)
        pcall(function()
            local response = HttpService:GetAsync("https://groups.roblox.com/v2/users/" .. userId .. "/groups/roles")
            local data = HttpService:JSONDecode(response)
            if data and data.data then
                for _, group in ipairs(data.data) do
                    if group.group.id == 12345678 then
                        stats.groupRank = group.role.name
                        break
                    end
                end
            end
        end)
        pcall(function()
            local response = HttpService:GetAsync("https://friends.roblox.com/v1/users/" .. userId .. "/friends/count")
            local data = HttpService:JSONDecode(response)
            if data and data.count then
                stats.friendsCount = tostring(data.count) .. " คน"
            end
        end)
        pcall(function()
            local response = HttpService:GetAsync("https://followings.roblox.com/v1/users/" .. userId .. "/followers/count")
            local data = HttpService:JSONDecode(response)
            if data and data.count then
                stats.followersCount = tostring(data.count) .. " คน"
            end
        end)
        pcall(function()
            local response = HttpService:GetAsync("https://economy.roblox.com/v1/users/" .. userId .. "/currency")
            local data = HttpService:JSONDecode(response)
            if data and data.robux then
                stats.robuxBalance = tostring(data.robux) .. " R$"
            end
        end)
    end)
end

-- ===== ฟังก์ชันโหลดชื่อแมพ =====
local function getCurrentMap()
    task.spawn(function()
        pcall(function()
            local response = HttpService:GetAsync("https://games.roblox.com/v1/games?universeIds=" .. game.GameId)
            local data = HttpService:JSONDecode(response)
            if data and data.data and #data.data > 0 then
                stats.currentMap = data.data[1].name or "ไม่พบชื่อแมพ"
            end
        end)
    end)
end

