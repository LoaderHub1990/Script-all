-- ===== ฟังก์ชันแปลงเวลา =====
local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    
    if hours > 0 then
        return string.format("%d:%02d:%02d", hours, minutes, secs)
    else
        return string.format("%02d:%02d", minutes, secs)
    end
end

-- ===== ฟังก์ชันคัดลอกข้อความ =====
local function copyToClipboard(text)
    local success = false
    pcall(function()
        local clipboard = game:GetService("ClipboardService")
        if clipboard then
            clipboard:SetText(text)
            success = true
        end
    end)
    if not success then
        pcall(function()
            if setclipboard then
                setclipboard(text)
                success = true
            end
        end)
    end
    if not success then
        pcall(function()
            if toclipboard then
                toclipboard(text)
                success = true
            end
        end)
    end
    if not success then
        pcall(function()
            if Clipboard then
                Clipboard:SetText(text)
                success = true
            end
        end)
    end
    return success
end

