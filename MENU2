    IgBtn.AnchorPoint = Vector2.new(1, 0.5)
    IgBtn.BackgroundColor3 = Color3.fromRGB(225, 48, 108)
    IgBtn.Text = "Instagram"
    IgBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    IgBtn.Font = Enum.Font.GothamBold
    IgBtn.TextSize = 12 * scale
    IgBtn.BorderSizePixel = 0
    Instance.new("UICorner", IgBtn).CornerRadius = UDim.new(0, 6 * scale)

    IgBtn.MouseEnter:Connect(function()
        TweenService:Create(IgBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(205, 28, 88),
            Size = UDim2.new(0, 95 * scale, 0, 35 * scale)
        }):Play()
    end)
    IgBtn.MouseLeave:Connect(function()
        TweenService:Create(IgBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(225, 48, 108),
            Size = UDim2.new(0, 90 * scale, 0, 33 * scale)
        }):Play()
    end)

    IgBtn.MouseButton1Click:Connect(function()
        local igLink = "https://instagram.com/your-username"
        local success = copyToClipboard(igLink)
        if success then
            showNotification("คัดลอกแล้ว!", "คัดลอกลิงก์ Instagram ไปคลิปบอร์ดแล้ว", 2)
        else
            showNotification("คัดลอกไม่ได้", "ลิงก์: " .. igLink, 4)
        end
    end)

    -- CLOSE
    local closeBtn = Instance.new("TextButton", Menu)
    closeBtn.Size = UDim2.new(0, 30 * scale, 0, 30 * scale)
    closeBtn.Position = UDim2.new(1, -10 * scale, 0, 10 * scale)
    closeBtn.AnchorPoint = Vector2.new(1, 0)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 16 * scale
    closeBtn.BorderSizePixel = 0
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)

    closeBtn.MouseEnter:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(255, 50, 60),
            Size = UDim2.new(0, 33 * scale, 0, 33 * scale)
        }):Play()
    end)
    closeBtn.MouseLeave:Connect(function()
        TweenService:Create(closeBtn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(255, 80, 80),
            Size = UDim2.new(0, 30 * scale, 0, 30 * scale)
        }):Play()
    end)

    closeBtn.MouseButton1Click:Connect(function()
        TweenService:Create(Menu, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
            Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1
        }):Play()
        task.wait(0.35)
        Menu:Destroy()
        CreateMainMenu()
    end)

    -- อัพเดท
    task.spawn(function()
        while Menu.Parent do
            task.wait(1)
            if stats.isRunning then
                stats.totalTime = stats.totalTime + 1
            end
            UserText.Text = Players.LocalPlayer.DisplayName .. "  |  ⏱️ " .. formatTime(stats.totalTime)
            StatusText.Text = stats.isRunning and "🟢 กำลังรัน: " .. stats.currentScript or "🔴 หยุดรัน"
        end
    end)

    TweenService:Create(Menu, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = frameSize, BackgroundTransparency = 0
    }):Play()
end

-- ===== เริ่มต้น =====
CreateMainMenu()
