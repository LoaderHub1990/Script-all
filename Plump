-- ============ AUTO MOVE FUNCTIONS ============
local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function tweenTo(cf,time)
    local tween = TweenService:Create(
        getHRP(),
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        {CFrame = cf}
    )
    tween:Play()
    tween.Completed:Wait()
end

local function teleport(cf)
    getHRP().CFrame = cf
end

-- ============ AUTO EAT FUNCTIONS ============
local function eat()
    pcall(function()
        remoteEvent:FireServer()
    end)
end

-- ============ AUTO RACE FUNCTIONS ============
local function endRace1()
    if not raceRunning1 then return end
    pcall(function()
        local hrp = getHRP()
        local randomOffset = Vector3.new(
            math.random(-5, 5),
            math.random(-2, 2),
            math.random(-5, 5)
        )
        hrp.CFrame = RacePoint1 + randomOffset
        local playerEndRace = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("Event"):WaitForChild("Race"):WaitForChild("PlayerEndRace")
        playerEndRace:FireServer()
    end)
end

