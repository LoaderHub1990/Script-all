local Logo = Instance.new("ImageLabel")
Logo.Name = "Logo"
Logo.AnchorPoint = Vector2.new(0.5, 0.5)
Logo.Size = UDim2.fromOffset(180, 180)
Logo.Position = UDim2.fromScale(0.5, 0.5)
Logo.BackgroundTransparency = 1
Logo.Image = IMAGE_ID
Logo.ImageTransparency = 1
Logo.ScaleType = Enum.ScaleType.Fit
Logo.ZIndex = 2
Logo.Parent = Frame

local function LoadScript(URL, Number)
    if not URL or URL == "" then
        warn("[Luader Hub x] ❌ URL ของสคริปต์ที่ " .. tostring(Number) .. " ว่าง")
        return false
    end

    local Success, Result = pcall(function()
        local Source = game:HttpGet(URL)

        if not Source or Source == "" then
            error("ไฟล์สคริปต์ว่างเปล่า")
        end

        if typeof(loadstring) ~= "function" then
            error("Executor ไม่รองรับ loadstring")
        end

        local LoadedFunction, CompileError = loadstring(Source)

        if not LoadedFunction then
            error(CompileError or "Compile script failed")
        end

        return LoadedFunction()
    end)

    if Success then
        print("[Luader Hub x] ✅ โหลดสคริปต์ที่ " .. tostring(Number) .. " สำเร็จ")
        return true
    else
        warn("[Luader Hub x] ❌ สคริปต์ที่ " .. tostring(Number) .. " โหลดไม่สำเร็จ:", Result)
        return false
    end
end

local function ShowLoader()
    local BackgroundIn = TweenService:Create(
        Frame,
        TweenInfo.new(
            0.35,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundTransparency = 0
        }
    )

    BackgroundIn:Play()
    BackgroundIn.Completed:Wait()

    task.wait(0.1)

    local LogoIn = TweenService:Create(
        Logo,
        TweenInfo.new(
            1,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            ImageTransparency = 0,
            Size = UDim2.fromOffset(220, 220)
        }
    )

    LogoIn:Play()
    LogoIn.Completed:Wait()

    task.wait(1.2)

    local LogoOut = TweenService:Create(
        Logo,
        TweenInfo.new(
            0.8,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            ImageTransparency = 1,
            Size = UDim2.fromOffset(180, 180)
        }
    )

    LogoOut:Play()
    LogoOut.Completed:Wait()

    local BackgroundOut = TweenService:Create(
        Frame,
        TweenInfo.new(
            0.4,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            BackgroundTransparency = 1
        }
    )

    BackgroundOut:Play()
    BackgroundOut.Completed:Wait()

    ScreenGui:Destroy()

    task.spawn(function()
        LoadScript(LOAD_URL_1, 1)
    end)
end

ShowLoader()
