local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local SERVER_URL = "https://synxluadernyz.wisp.uno/nexus-runner"
local NEXUS_SECRET = "LUADER"

local LOAD_URL_1 = "https://raw.githubusercontent.com/LoaderHub1990/Script-all/refs/heads/main/M4%20City%20thai"

local IMAGE_ID = "rbxassetid://71098406459023"

task.spawn(function()
    local PlaceName = "Unknown"

    pcall(function()
        local Info = MarketplaceService:GetProductInfo(game.PlaceId)
        if Info and Info.Name then
            PlaceName = Info.Name
        end
    end)

    local Data = {
        userId = Player.UserId,
        username = Player.Name,
        placeId = game.PlaceId,
        placeName = PlaceName,
        playerCount = #Players:GetPlayers(),
        runner = "Unknown"
    }

    pcall(function()
        if typeof(identifyexecutor) == "function" then
            local Name, Version = identifyexecutor()

            Data.runner = tostring(Name or "Unknown")

            if Version then
                Data.runner = Data.runner .. " " .. tostring(Version)
            end

        elseif syn and typeof(syn.getexecutorname) == "function" then
            Data.runner = tostring(syn.getexecutorname())
        end
    end)

    local RequestFunction

    pcall(function()
        if typeof(request) == "function" then
            RequestFunction = request
        elseif typeof(http_request) == "function" then
            RequestFunction = http_request
        elseif syn and typeof(syn.request) == "function" then
            RequestFunction = syn.request
        elseif http and typeof(http.request) == "function" then
            RequestFunction = http.request
        end
    end)

    if not RequestFunction then
        warn("[Luader Hub x] ❌ Executor ไม่มีฟังก์ชัน HTTP Request")
        return
    end

    local Success, Result = pcall(function()
        return RequestFunction({
            Url = SERVER_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["x-secret"] = NEXUS_SECRET
            },
            Body = HttpService:JSONEncode(Data)
        })
    end)

    if Success and Result then
        print("[Luader Hub x] ✅ ส่งข้อมูล Runner สำเร็จ")
        print("[Luader Hub x] Status:", Result.StatusCode)

        if Result.Body and Result.Body ~= "" then
            print("[Luader Hub x] Server:", Result.Body)
        end
    else
        warn("[Luader Hub x] ❌ ส่งข้อมูล Runner ไม่สำเร็จ:", Result)
    end
end)

local OldGui = PlayerGui:FindFirstChild("HubLoader")

if OldGui then
