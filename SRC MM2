local _localSound = nil

local function stopLocalSound()
    if _localSound then
        _localSound:Stop()
        _localSound:Destroy()
        _localSound = nil
    end
end

local function playLocalSound(id)
    stopLocalSound()

    local soundParent =
        workspace.CurrentCamera

    local s = Instance.new("Sound")

    s.Name = "MM2_LocalRadio"
    s.SoundId = "rbxassetid://" .. id
    s.Volume = 0.5
    s.Looped = true
    s.RollOffMaxDistance = 0
    s.Parent = soundParent

    s:Play()

    _localSound = s
end

