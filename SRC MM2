local function CreateTag(player)
    if player == LocalPlayer then return end
    if tagObjects[player] then return end

    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = "Tag_" .. player.Name
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 220, 0, 36)
    Billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    Billboard.LightInfluence = 0
    Billboard.Parent = ESPTagFolder

    local TagFrame = Instance.new("Frame")

    TagFrame.Parent = Billboard
    TagFrame.BackgroundColor3 =
        Color3.fromRGB(20, 20, 20)

    TagFrame.BackgroundTransparency = 0.5
    TagFrame.AutomaticSize = Enum.AutomaticSize.X
    TagFrame.Size = UDim2.new(0, 0, 1, 0)
    TagFrame.Position = UDim2.new(0.5, 0, 0.05, 0)
    TagFrame.AnchorPoint = Vector2.new(0.5, 0)

    Instance.new("UICorner", TagFrame).CornerRadius =
        UDim.new(0, 8)

    local Padding = Instance.new("UIPadding", TagFrame)

    Padding.PaddingLeft = UDim.new(0, 6)
    Padding.PaddingRight = UDim.new(0, 8)
    Padding.PaddingTop = UDim.new(0, 3)
    Padding.PaddingBottom = UDim.new(0, 3)

    local ListLayout =
        Instance.new("UIListLayout", TagFrame)

    ListLayout.FillDirection =
        Enum.FillDirection.Horizontal

    ListLayout.VerticalAlignment =
        Enum.VerticalAlignment.Center

    ListLayout.Padding = UDim.new(0, 5)
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local Stroke = Instance.new("UIStroke", TagFrame)

    Stroke.Thickness = 2
    Stroke.ApplyStrokeMode =
        Enum.ApplyStrokeMode.Border

    local Gradient = Instance.new("UIGradient", Stroke)

    Gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(
            0,
            Color3.fromRGB(180, 0, 255)
        ),

        ColorSequenceKeypoint.new(
            1,
            Color3.fromRGB(80, 0, 150)
        )
    }

    local AvatarImage = Instance.new("ImageLabel")

    AvatarImage.Parent = TagFrame
    AvatarImage.LayoutOrder = 1
    AvatarImage.BackgroundTransparency = 1
    AvatarImage.Size = UDim2.new(0, 24, 0, 24)
    AvatarImage.Image =
        GetAvatarImage(player.UserId)

    local AvatarCorner =
        Instance.new("UICorner", AvatarImage)

    AvatarCorner.CornerRadius = UDim.new(1, 0)

    local NameLabel = Instance.new("TextLabel")

    NameLabel.Parent = TagFrame
    NameLabel.LayoutOrder = 2
    NameLabel.BackgroundTransparency = 1
    NameLabel.AutomaticSize = Enum.AutomaticSize.X
    NameLabel.Size = UDim2.new(0, 0, 1, 0)
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.TextSize = 12
    NameLabel.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    NameLabel.TextXAlignment =
        Enum.TextXAlignment.Left

    NameLabel.Text = player.Name
    NameLabel.TextStrokeTransparency = 0.7
    NameLabel.TextStrokeColor3 =
        Color3.fromRGB(0, 0, 0)

    tagObjects[player] = {
        Billboard = Billboard,
        NameLabel = NameLabel,
        AvatarImage = AvatarImage,
    }
end

local function RemoveTag(player)
    local data = tagObjects[player]

    if data then
        if data.Billboard then
            data.Billboard:Destroy()
        end

        tagObjects[player] = nil
    end
end

local tagConnection = nil
local tagPlayerAdded = nil
local tagPlayerRemoving = nil
local espTagEnabled = false

EspTab:Toggle({
    Title = "ESP Tagname",
    Desc = "แสดงชื่อเหนือหัว",
    Value = false,

    Callback = function(v)
        espTagEnabled = v

        if v then
            for _, plr in ipairs(Players:GetPlayers()) do
                CreateTag(plr)
            end

            tagConnection =
                RunService.RenderStepped:Connect(function()

                    if not espTagEnabled then return end

                    local roles = getRoles()

                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr == LocalPlayer then
                            continue
                        end

                        local data = tagObjects[plr]

                        if not data then
                            CreateTag(plr)
                            data = tagObjects[plr]
                        end

                        if not data then
                            continue
                        end

                        local char = plr.Character
                        local head =
                            char and char:FindFirstChild("Head")

                        local hum =
                            char and char:FindFirstChildOfClass(
                                "Humanoid"
                            )

                        if head and hum and hum.Health > 0 then
                            data.Billboard.Adornee = head
                            data.Billboard.Enabled = true

                            local role =
                                roles[plr.Name]

                            local color = TagColors.Default
                            local label = plr.Name

                            if role then
                                color =
                                    TagColors[role]
                                    or TagColors.Default

                                label =
                                    plr.Name ..
                                    " | " ..
                                    role
                            end

                            data.NameLabel.TextColor3 = color
                            data.NameLabel.Text = label
                        else
                            data.Billboard.Enabled = false
                        end
                    end
                end)

            tagPlayerAdded =
                Players.PlayerAdded:Connect(function(plr)
                    if espTagEnabled then
                        task.wait(1)

                        if espTagEnabled then
                            CreateTag(plr)
                        end
                    end
                end)

            tagPlayerRemoving =
                Players.PlayerRemoving:Connect(function(plr)
                    RemoveTag(plr)
                end)

        else
            if tagConnection then
                tagConnection:Disconnect()
                tagConnection = nil
            end

            if tagPlayerAdded then
                tagPlayerAdded:Disconnect()
                tagPlayerAdded = nil
            end

            if tagPlayerRemoving then
                tagPlayerRemoving:Disconnect()
                tagPlayerRemoving = nil
            end

            for plr in pairs(tagObjects) do
                RemoveTag(plr)
            end

            for _, obj in pairs(
                ESPTagFolder:GetChildren()
            ) do
                obj:Destroy()
            end

            table.clear(tagObjects)
        end
    end
})

local function createRoleESP(
    plr,
    color,
    text,
    espName
)
    if not plr.Character or plr == LocalPlayer then
        return
    end

    local char = plr.Character
    local head = char:FindFirstChild("Head")

    if not char or not head then
        return
    end

    local hl =
        char:FindFirstChild(
            espName .. "_HL"
        )

    if not hl then
        hl = Instance.new("Highlight")

        hl.Name = espName .. "_HL"
        hl.DepthMode =
            Enum.HighlightDepthMode.AlwaysOnTop

        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char
    end

    hl.FillColor = color
    hl.OutlineColor = Color3.new(1, 1, 1)

    local bill =
        char:FindFirstChild(
            espName .. "_BILL"
        )

    if not bill then
        bill = Instance.new("BillboardGui")

        bill.Name = espName .. "_BILL"
        bill.Size = UDim2.new(0, 100, 0, 22)
        bill.StudsOffset =
            Vector3.new(0, 2.5, 0)

        bill.AlwaysOnTop = true
        bill.Adornee = head
        bill.Parent = char

        local txt = Instance.new("TextLabel")

        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextScaled = true
        txt.Font = Enum.Font.GothamBold
        txt.TextStrokeTransparency = 0
        txt.Parent = bill
    end

    local txt =
        bill:FindFirstChildOfClass(
            "TextLabel"
        )

    txt.Text = text
    txt.TextColor3 = color
end

