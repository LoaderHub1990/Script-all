    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot(plr)
    local char = getCharacter(plr)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getGunDrop()
    return workspace:FindFirstChild("GunDrop", true)
end

local function getRoles()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)

    if not remote then
        warn("GetPlayerData not found")
        return {}
    end

    local success, result = pcall(function()
        return remote:InvokeServer()
    end)

    if not success then
        warn(result)
        return {}
    end

    local roles = {}

    for plrName, data in pairs(result) do
        if not data.Dead then
            roles[plrName] = data.Role
        end
    end

    return roles
end

local function GetMurdererHead()
    local roles = getRoles()

    for plrName, role in pairs(roles) do
        if role == "Murderer" then
            local target = Players:FindFirstChild(plrName)

            if target
                and target ~= LocalPlayer
                and target.Character
                and target.Character:FindFirstChild("Head")
                and target.Character:FindFirstChild("Humanoid")
                and target.Character.Humanoid.Health > 0
            then
                return target.Character.Head, target
            end
        end
    end

    return nil, nil
end

-- SHOOT MURDERER

local function ShootMurdererAction()
    local _, targetPlayer = GetMurdererHead()

    if not targetPlayer
        or not targetPlayer.Character
        or not targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    then
        warn("ไม่พบ Murderer หรือเป้าหมายไม่อยู่")
        return
    end

    local Gun =
        LocalPlayer.Character:FindFirstChild("Gun")
        or LocalPlayer.Backpack:FindFirstChild("Gun")

    if not Gun then
        warn("คุณไม่มีปืน!")
        return
    end

    local ShootRemote = Gun:FindFirstChild("Shoot")

    if not ShootRemote then
        warn("ไม่พบ Remote Shoot")
        return
    end

    local HRP = targetPlayer.Character.HumanoidRootPart
    local TargetPos = HRP.Position
    local Velocity = HRP.AssemblyLinearVelocity
    local IsJumping = Velocity.Y > 1

    if getgenv().ShootMode == "Wallbang" then

        local PredictOffset = Velocity * 0.08
        local PredictedPos = TargetPos + PredictOffset

        local JumpOffset =
            IsJumping
            and Vector3.new(0, math.abs(Velocity.Y) * 0.1, 0)
            or Vector3.zero

        local shootPoints = {
            PredictedPos + JumpOffset,
            PredictedPos + JumpOffset + Vector3.new(0, 1, 0),
            PredictedPos + JumpOffset - Vector3.new(0, 1, 0),
        }

        for _, pos in ipairs(shootPoints) do
            ShootRemote:FireServer(
                CFrame.new(
                    pos + (-HRP.CFrame.LookVector * 3),
                    pos
                ),
                CFrame.new(pos)
            )
        end

    elseif getgenv().ShootMode == "Silent Aim" then

        local myChar = LocalPlayer.Character
        if not myChar then return end

        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local myPos = myHRP.Position

        local PredictOffset = Velocity * 0.1
        local PredictedPos = TargetPos + PredictOffset

        local JumpOffset =
            IsJumping
            and Vector3.new(0, math.abs(Velocity.Y) * 0.1, 0)
            or Vector3.zero

        local FinalTarget = PredictedPos + JumpOffset

        local shootPoints = {
            FinalTarget,
            FinalTarget + Vector3.new(0, 1, 0),
            FinalTarget - Vector3.new(0, 0.5, 0),
        }

        for _, pos in ipairs(shootPoints) do
            ShootRemote:FireServer(
                CFrame.new(myPos, pos),
                CFrame.new(pos)
            )
        end
    end
end

