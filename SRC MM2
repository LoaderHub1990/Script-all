-- แก้ไข Keybind ให้ใช้ getgenv().KillAllEnabled
UserInputService.InputBegan:Connect(
    function(input, gameProcessed)

        if gameProcessed then return end

        if input.UserInputType ~=
            Enum.UserInputType.Keyboard
        then
            return
        end

        local key = input.KeyCode

        if key == Keybinds.Shoot then
            ShootMurdererAction()

        elseif key == Keybinds.KillAll then
            getgenv().KillAllEnabled = not getgenv().KillAllEnabled
            auraEnabled = getgenv().KillAllEnabled
            print("Kill All: " .. tostring(getgenv().KillAllEnabled))

        elseif key == Keybinds.ThrowKnife then
            ThrowKnifeAction()

        elseif key == Keybinds.KillSheriff then

            if not Root then return end

            local myChar =
                LocalPlayer.Character

            if not myChar then return end

            local Knife =
                myChar:FindFirstChild("Knife")

            if not Knife then
                local bpKnife =
                    LocalPlayer.Backpack:FindFirstChild(
                        "Knife"
                    )

                if bpKnife then
                    myChar:FindFirstChildOfClass(
                        "Humanoid"
                    ):EquipTool(bpKnife)

                    task.wait(0.15)
                end
            end

            for plr, role in pairs(getRoles()) do
                if role == "Sheriff"
                    or role == "Hero"
                then

                    local target =
                        Players:FindFirstChild(plr)

                    if target
                        and target ~= LocalPlayer
                        and target.Character
                    then

                        local enemyRoot =
                            target.Character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if enemyRoot then
                            enemyRoot.CFrame =
                                Root.CFrame *
                                CFrame.new(0, 0, -3)

                            task.spawn(function()
                                for i = 1, 15 do
                                    if enemyRoot and Root then
                                        enemyRoot.CFrame =
                                            Root.CFrame *
                                            CFrame.new(
                                                0,
                                                0,
                                                -3
                                            )
                                    end

                                    task.wait(0.03)
                                end
                            end)
                        end
                    end
                end
            end

        elseif key == Keybinds.GrabGun then
            local gun = getGunDrop()

            if gun and LocalPlayer.Character then
                LocalPlayer.Character:PivotTo(
                    gun.CFrame
                )
            end
        end
    end
)


