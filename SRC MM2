-- THROW KNIFE

local function ThrowKnifeAction()
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and player.Character
            and player.Character:FindFirstChild("HumanoidRootPart")
        then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")

            if hum and hum.Health > 0 then
                local dist =
                    (player.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude

                if dist < shortestDistance then
                    shortestDistance = dist
                    closestPlayer = player
                end
            end
        end
    end

    if not closestPlayer then
        warn("ไม่พบเป้าหมาย!")
        return
    end

    local Knife = myChar:FindFirstChild("Knife")

    if not Knife then
        local bpKnife = LocalPlayer.Backpack:FindFirstChild("Knife")

        if bpKnife then
            myChar:FindFirstChildOfClass("Humanoid"):EquipTool(bpKnife)
            task.wait(0.15)
            Knife = myChar:FindFirstChild("Knife")
        end
    end

    if not Knife then
        warn("ไม่มีมีด!")
        return
    end

    local Events = Knife:FindFirstChild("Events")

    if not Events then
        warn("หา Events ไม่เจอ!")
        return
    end

    local ThrowRemote = Events:FindFirstChild("KnifeThrown")

    if not ThrowRemote then
        warn("หา KnifeThrown ไม่เจอ!")
        return
    end

    local targetPos =
        closestPlayer.Character.HumanoidRootPart.Position

    local myPos = myRoot.Position

    ThrowRemote:FireServer(
        CFrame.new(myPos, targetPos),
        CFrame.new(targetPos)
    )
end

