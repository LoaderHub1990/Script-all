local antiFlingConn = nil
local antiFlingCharConn = nil

local function applyAntiFling()
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then

                    for _, enemyPart in ipairs(
                        plr.Character:GetDescendants()
                    ) do
                        if enemyPart:IsA("BasePart") then
                            local nc =
                                Instance.new("NoCollisionConstraint")

                            nc.Part0 = part
                            nc.Part1 = enemyPart
                            nc.Parent = char
                        end
                    end
                end
            end
        end
    end
end

local function clearAntiFling()
    local char = LocalPlayer.Character
    if not char then return end

    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("NoCollisionConstraint") then
            v:Destroy()
        end
    end
end

HomeTab:Toggle({
    Title = "Anti Fling",
    Desc = "กันโดนดีด",
    Value = false,

    Callback = function(v)
        getgenv().AntiFling = v

        if v then
            applyAntiFling()

            antiFlingConn =
                Players.PlayerAdded:Connect(function(plr)

                    plr.CharacterAdded:Connect(function()
                        task.wait(1)

                        if getgenv().AntiFling then
                            applyAntiFling()
                        end
                    end)
                end)

            antiFlingCharConn =
                LocalPlayer.CharacterAdded:Connect(function()
                    task.wait(0.5)

                    if getgenv().AntiFling then
                        applyAntiFling()
                    end
                end)

        else
            clearAntiFling()

            if antiFlingConn then
                antiFlingConn:Disconnect()
                antiFlingConn = nil
            end

            if antiFlingCharConn then
                antiFlingCharConn:Disconnect()
                antiFlingCharConn = nil
            end
        end
    end
})

