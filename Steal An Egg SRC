local function ApplySpeed()
    local Character = _vu5.Character or _vu5.CharacterAdded:Wait()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid:Destroy()
        task.wait(0.05)
    end

    local NewHumanoid = Instance.new("Humanoid")
    NewHumanoid.Parent = Character
    NewHumanoid.WalkSpeed = Speed
end

local function ChangeCurrentSpeed()
    local Character = _vu5.Character

    if not Character then
        return
    end

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.WalkSpeed = Speed
    end
end

local Sliding = false

local function UpdateSlider(X)
    local Start = Slider.AbsolutePosition.X
    local Width = Slider.AbsoluteSize.X

    local Percent = math.clamp((X - Start) / Width, 0, 1)

    Speed = math.floor(
        MinSpeed + ((MaxSpeed - MinSpeed) * Percent)
    )

    SpeedText.Text = "WalkSpeed : " .. Speed
    Fill.Size = UDim2.new(Percent,0,1,0)
    Knob.Position = UDim2.new(Percent,0,.5,0)

    if Enabled then
        ChangeCurrentSpeed()
    end
end

Slider.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Sliding = true
        UpdateSlider(Input.Position.X)
    end
end)

Knob.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Sliding = true
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Sliding and Input.UserInputType == Enum.UserInputType.MouseMovement then
        UpdateSlider(Input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Sliding = false
    end
end)

UseButton.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    if Enabled then
        UseButton.Text = "✓ SPEED ON"
        UseButton.BackgroundColor3 = Color3.fromRGB(50,120,75)

        ApplySpeed()
    else
        UseButton.Text = "SPEED OFF"
        UseButton.BackgroundColor3 = Color3.fromRGB(45,45,58)

        local Character = _vu5.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

        if Humanoid then
            Humanoid.WalkSpeed = 16
        end
    end
end)

_vu5.CharacterAdded:Connect(function()
    if Enabled then
        task.wait(0.2)
        ApplySpeed()
    end
end)

local Dragging = false
local DragStart
local StartPosition

Title.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragStart = Input.Position
        StartPosition = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(Input)
    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
        local Delta = Input.Position - DragStart

        Main.Position = UDim2.new(
            StartPosition.X.Scale,
            StartPosition.X.Offset + Delta.X,
            StartPosition.Y.Scale,
            StartPosition.Y.Offset + Delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end
end)

