local function IsWallBlocked(fromPos, toPos, ignoreChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}

    local result = Workspace:Raycast(fromPos, toPos - fromPos, params)

    if result then
        return not result.Instance:IsDescendantOf(ignoreChar)
    end

    return false
end

-- ========== Silent Aim ==========

local function GetTarget()
    if not Config.SilentAim then
        CurrentTarget = nil
        TargetCount = 0
        return nil
    end

    local closestPart = nil
    local closestPlayer = nil
    local closestDist = Config.FOV + 1
    local count = 0
    local screenCenter = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local myChar = LocalPlayer.Character
    local myRoot = myChar and (
        myChar:FindFirstChild("HumanoidRootPart")
        or myChar:FindFirstChild("UpperTorso")
        or myChar:FindFirstChild("Torso")
    )

    if not myRoot then
        CurrentTarget = nil
        TargetCount = 0
        return nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not IsSkipped(player) then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local aimPart = char:FindFirstChild(Config.AimPart)
                or char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")

            if humanoid and humanoid.Health > 0 and aimPart and root then
                local teamCheck = Config.TeamCheck
                    and player.Team
                    and LocalPlayer.Team
                    and player.Team == LocalPlayer.Team

                if not teamCheck
                    and (myRoot.Position - root.Position).Magnitude <= Config.MaxDistance then

                    local pos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)

                    if onScreen and pos.Z > 0 then
                        local dist = (
                            Vector2.new(pos.X, pos.Y) - screenCenter
                        ).Magnitude

                        if dist <= Config.FOV then
                            local wallBlocked = Config.WallCheck
                                and IsWallBlocked(
                                    Camera.CFrame.Position,
                                    aimPart.Position,
                                    char
                                )

                            if not wallBlocked then
                                count += 1

                                if dist < closestDist then
                                    closestDist = dist
                                    closestPlayer = player
                                    closestPart = aimPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    CurrentTarget = closestPlayer
    TargetCount = count

    return closestPart
end

local HookedHandlers = setmetatable({}, {__mode = "k"})
local hookWarned = false
local hookCallCount = 0

-- หาโมดูล ProjectileHandler (ลองเส้นทางเดิมก่อน แล้วค้นหาโมดูลที่ชื่อมีคำว่า projectile)
local function ResolveProjectileHandler()
    local ok, handler = pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local mod = modules and modules:FindFirstChild("ProjectileHandler")

        if mod then
            return require(mod)
        end

        return nil
    end)

    if ok and typeof(handler) == "table" and typeof(handler.SimulateProjectile) == "function" then
        return handler
    end

    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") and string.find(string.lower(d.Name), "projectile", 1, true) then
            local ok2, res = pcall(require, d)

            if ok2 and typeof(res) == "table" and typeof(res.SimulateProjectile) == "function" then
                return res
            end
        end
    end

    return nil
end

-- แทนทิศทางกระสุนในอาร์กิวเมนต์ (ตำแหน่งเดิม 13, 14) ถ้าไม่เจอ Vector3 ตรงนั้น
-- จะลองหา Vector3 ที่ยาวประมาณ 1 (เวกเตอร์ทิศทาง) แทน เผื่อเกมอัปเดตแล้วลำดับอาร์กิวเมนต์เปลี่ยน
local function RedirectArgs(args, unit)
    local replaced = false

    for _, i in ipairs({13, 14}) do
        local a = args[i]

        if typeof(a) == "Vector3" then
            args[i] = unit
            replaced = true
        elseif typeof(a) == "table" then
            for k, v in pairs(a) do
                if typeof(v) == "Vector3" then
                    a[k] = unit
                    replaced = true
                end
            end
        end
    end

    if not replaced then
        for i = 1, args.n do
            local a = args[i]

            if typeof(a) == "Vector3" and math.abs(a.Magnitude - 1) < 0.01 then
                args[i] = unit
                replaced = true
            end
        end
    end

    return replaced
end

-- คืน true ถ้า hook สำเร็จ
local function HookProjectile()
    local handler = ResolveProjectileHandler()

    if not handler then
        if not hookWarned then
            hookWarned = true
            warn("[Flexozy] ไม่พบ ProjectileHandler / SimulateProjectile (ชื่อโมดูลอาจเปลี่ยน หรือเกมยังโหลดไม่เสร็จ)")
        end

        return false
    end

    local existing = HookedHandlers[handler]

    if existing and handler.SimulateProjectile == existing then
        Hooked = true
        return true
    end

    local original = handler.SimulateProjectile

    local function wrapper(...)
        hookCallCount += 1
        local log = hookCallCount <= 3

        if Config.SilentAim then
            local targetPart = GetTarget()

            if targetPart and targetPart.Parent then
                -- table.pack/unpack กันอาร์กิวเมนต์ที่เป็น nil ทำให้ถูกตัดท้าย
                local args = table.pack(...)
                local origin = args[15]
                local worldPos

                if origin then
                    if typeof(origin) == "Instance"
                        and origin:IsA("Attachment") then
                        worldPos = origin.WorldPosition
                    elseif typeof(origin) == "Vector3" then
                        worldPos = origin
                    end
                end

                if not worldPos
                    and args[11]
                    and typeof(args[11]) == "Instance" then

                    local firePoint = args[11]:FindFirstChild("GunFirePoint")
                        or args[11]:FindFirstChild("FirePoint")

                    if firePoint then
                        worldPos = firePoint:IsA("Attachment")
                            and firePoint.WorldPosition
                            or firePoint.Position
                    end
                end

                if not worldPos and LocalPlayer.Character then
                    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        worldPos = root.Position
                    end
                end

                if not worldPos then
                    worldPos = Camera.CFrame.Position
                end

                local dir = targetPart.Position - worldPos
                local replaced = false

                if dir.Magnitude > 0.001 then
                    replaced = RedirectArgs(args, dir.Unit)
                end

                if log then
                    print(string.format(
                        "[Flexozy] SimulateProjectile ถูกเรียก (ครั้งที่ %d) | เป้า: %s | อาร์กิวเมนต์: %d | แก้ทิศทางได้: %s",
                        hookCallCount, targetPart.Parent.Name, args.n, tostring(replaced)
                    ))
                end

                return original(table.unpack(args, 1, args.n))
            elseif log then
                print(string.format("[Flexozy] SimulateProjectile ถูกเรียก (ครั้งที่ %d) แต่ไม่มีเป้าหมายในระยะ/FOV", hookCallCount))
            end
        elseif log then
            print(string.format("[Flexozy] SimulateProjectile ถูกเรียก (ครั้งที่ %d) แต่ SilentAim ปิดอยู่", hookCallCount))
        end

        return original(...)
    end

    handler.SimulateProjectile = wrapper
    HookedHandlers[handler] = wrapper

    Hooked = true
    hookWarned = false
    print("[Flexozy] Hooked")

    return true
end

-- ถ้ายังไม่เจอโมดูล จะลองใหม่ทุก 3 วินาทีตราบที่ SilentAim เปิดอยู่
local hookLoopToken = 0

local function EnsureHook()
    hookLoopToken += 1
    local token = hookLoopToken

    task.spawn(function()
        while Config.SilentAim and not Hooked and hookLoopToken == token do
            if HookProjectile() then break end

            task.wait(3)
        end
    end)
end

-- ========== Tool / Inventory helpers ==========

local function GetToolIcon(tool)
    if not tool or not tool:IsA("Tool") then
        return ""
    end

    local ok, texId = pcall(function()
        return tool.TextureId
    end)

    if ok and texId and texId ~= "" then
        return texId
    end

    local attr = tool:GetAttribute("Icon")
        or tool:GetAttribute("IconId")
        or tool:GetAttribute("Image")

    if attr then
        if typeof(attr) == "number" then
            return "rbxassetid://" .. attr
        elseif typeof(attr) == "string" and attr ~= "" then
            return attr
        end
    end

    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Texture and obj.Texture ~= "" then
                return obj.Texture
            end
        end
    end

    local handle = tool:FindFirstChild("Handle")

    if handle and handle:IsA("BasePart") then
        local texture = handle:FindFirstChildOfClass("Texture")

        if texture and texture.Texture and texture.Texture ~= "" then
            return texture.Texture
        end

        local decal = handle:FindFirstChildOfClass("Decal")

        if decal and decal.Texture and decal.Texture ~= "" then
            return decal.Texture
        end
    end

    return ""
end

local function GetInventoryList(player, data)
    local equipped = {}
    local backpack = {}

    if player.Character then
        for _, child in ipairs(player.Character:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(equipped, {
                    Name = child.Name,
                    Icon = GetToolIcon(child),
                    Tool = child
                })
            end
        end
    end

    local bp = player:FindFirstChild("Backpack")

    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(backpack, {
                    Name = child.Name,
                    Icon = GetToolIcon(child),
                    Tool = child
                })
            end
        end
    end

    if data and data.EquippedOrder then
        table.sort(equipped, function(a, b)
            local oa = data.EquippedOrder[a.Tool] or 0
            local ob = data.EquippedOrder[b.Tool] or 0
            return oa > ob
        end)
    end

    return equipped, backpack
end

-- ========== Infinite Stamina (สเตมิน่าไม่ลด) ==========
-- หาค่าสเตมิน่าที่เก็บในฝั่งผู้เล่น (Attribute หรือ NumberValue/IntValue ของ Player/Character)
-- แล้วคืนค่ากลับทันทีที่เกมลดมัน ใช้ไม่ได้ถ้าเกมเก็บสเตมิน่าไว้ในตัวแปรของสคริปต์หรือเซิร์ฟเวอร์เป็นคนคุม

local StaminaKeywords = {"stamina"}
local StaminaIgnore = {"max", "regen", "drain", "cost", "rate", "delay", "cooldown", "speed", "mult", "time"}
local StaminaEntries = setmetatable({}, {__mode = "k"})
local StaminaToken = 0

local function NameHas(name, list)
    local lower = string.lower(name)

    for _, kw in ipairs(list) do
        if kw ~= "" and string.find(lower, kw, 1, true) then
            return true
        end
    end

    return false
end

local function IsStaminaName(name)
    return NameHas(name, StaminaKeywords) and not NameHas(name, StaminaIgnore)
end

-- ค่าสูงสุดของสเตมิน่า (ถ้าเกมมี MaxStamina / StaminaMax ฯลฯ ข้างๆ)
local function FindMaxFor(owner, name, isAttr)
    if not owner then return nil end

    local names = {"Max" .. name, name .. "Max", "Max_" .. name, name .. "_Max"}

    for _, n in ipairs(names) do
        if isAttr then
            local v = owner:GetAttribute(n)

            if typeof(v) == "number" then
                return v
            end
        else
            local child = owner:FindFirstChild(n)

            if child and child:IsA("ValueBase") and typeof(child.Value) == "number" then
                return child.Value
            end
        end
    end

    return nil
end

local function HookStaminaAttr(owner, name)
    local bucket = StaminaEntries[owner]

    if not bucket then
        bucket = {}
        StaminaEntries[owner] = bucket
    end

    if bucket[name] then return false end

    local entry = {max = 0}
    bucket[name] = entry

    local function restore()
        local v = owner:GetAttribute(name)
        if typeof(v) ~= "number" then return end

        if v > entry.max then
            entry.max = v
        end

        local target = FindMaxFor(owner, name, true) or entry.max

        if v < target then
            owner:SetAttribute(name, target)
        end
    end

    entry.conn = owner:GetAttributeChangedSignal(name):Connect(restore)
    restore()

    return true
end

local function HookStaminaValue(inst)
    local bucket = StaminaEntries[inst]
    if bucket then return false end

    local entry = {max = 0}
    StaminaEntries[inst] = {Value = entry}

    local function restore()
        local v = inst.Value
        if typeof(v) ~= "number" then return end

        if v > entry.max then
            entry.max = v
        end

        local target = FindMaxFor(inst.Parent, inst.Name, false) or entry.max

        if inst:IsA("IntValue") then
            target = math.floor(target)
        end

        if v < target then
            inst.Value = target
        end
    end

    entry.conn = inst:GetPropertyChangedSignal("Value"):Connect(restore)
    restore()

    return true
end

local function ScanStaminaInstance(inst)
    local added = 0

    for name, value in pairs(inst:GetAttributes()) do
        if typeof(value) == "number" and IsStaminaName(name) then
            if HookStaminaAttr(inst, name) then
                added += 1
            end
        end
    end

    if (inst:IsA("NumberValue") or inst:IsA("IntValue")) and IsStaminaName(inst.Name) then
        if HookStaminaValue(inst) then
            added += 1
        end
    end

    return added
end

local function ForEachPlayerInstance(fn)
    local function tree(root)
        fn(root)

        for _, d in ipairs(root:GetDescendants()) do
            fn(d)
        end
    end

    fn(LocalPlayer)

    -- ข้าม PlayerGui (เป็นแค่ UI ไม่ใช่ตัวเก็บค่าจริง และมีของเยอะ)
    for _, child in ipairs(LocalPlayer:GetChildren()) do
        if not child:IsA("PlayerGui") then
            tree(child)
        end
    end

    if LocalPlayer.Character then
        tree(LocalPlayer.Character)
    end
end

local function CountStamina()
    local n = 0

    for _, bucket in pairs(StaminaEntries) do
        for _, entry in pairs(bucket) do
            if entry.conn and entry.conn.Connected then
                n += 1
            end
        end
    end

    return n
end

local function ScanStamina()
    ForEachPlayerInstance(ScanStaminaInstance)
end

