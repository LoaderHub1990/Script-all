-- ========== วิธี A: ล็อก upvalue ของฟังก์ชันที่ผูกกับปุ่มวิ่ง ==========
-- ดัดแปลงจากสคริปต์เดิม (ล็อก upvalue ตำแหน่งที่ 6 ตายตัวที่ MobileGUI.MobileButtons.RunButton)
-- ตอนนี้: หาปุ่มวิ่งเองแบบยืดหยุ่น + หาตำแหน่ง upvalue ของสเตมิน่าอัตโนมัติ (หรือกำหนดเองได้)

local ST = {
    max = 100,
    index = 0, -- 0 = อัตโนมัติ
    stats = setmetatable({}, {__mode = "k"}),
}

local function StaminaSupported()
    return typeof(getconnections) == "function"
        and typeof(dbg) == "table"
        and typeof(dbg.setupvalue) == "function"
        and (typeof(dbg.getupvalue) == "function" or typeof(dbg.getupvalues) == "function")
end

-- คืนตาราง [ตำแหน่ง] = ค่า ของ upvalue ทั้งหมดในฟังก์ชัน
local function GetUpvalues(fn)
    local out = {}

    if typeof(dbg.getupvalues) == "function" then
        local ok, t = pcall(dbg.getupvalues, fn)

        if ok and typeof(t) == "table" then
            for i, v in pairs(t) do
                out[i] = v
            end

            return out
        end
    end

    if typeof(dbg.getupvalue) == "function" then
        for i = 1, 60 do
            local ok, a, b = pcall(dbg.getupvalue, fn, i)

            if not ok or (a == nil and b == nil) then break end

            local v = a

            -- executor บางตัวคืน (ชื่อ, ค่า) แบบ Lua มาตรฐาน
            if typeof(a) == "string" and b ~= nil then
                v = b
            end

            out[i] = v
        end
    end

    return out
end

local function FindRunButtons()
    local buttons, seen = {}, {}

    local function add(b)
        if b and not seen[b] and b:IsA("GuiButton") then
            seen[b] = true
            table.insert(buttons, b)
        end
    end

    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return buttons end

    -- เส้นทางเดิมของสคริปต์เพื่อน
    local mg = pg:FindFirstChild("MobileGUI")
    local mb = mg and mg:FindFirstChild("MobileButtons")
    add(mb and mb:FindFirstChild("RunButton"))

    -- ค้นหาแบบยืดหยุ่น: ปุ่มที่ชื่อมี run / sprint (เผื่อเกมย้ายหรือเปลี่ยนชื่อ)
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiButton") then
            local n = string.lower(d.Name)

            if string.find(n, "run", 1, true) or string.find(n, "sprint", 1, true) then
                add(d)
            end
        end

        if #buttons >= 12 then break end
    end

    return buttons
end

local RunButtonSignals = {"MouseButton1Click", "MouseButton1Down", "Activated", "TouchTap", "MouseButton1Up"}

local function CollectRunFunctions()
    local fns, seen = {}, {}

    for _, btn in ipairs(FindRunButtons()) do
        for _, sig in ipairs(RunButtonSignals) do
            local ok, conns = pcall(function()
                return getconnections(btn[sig])
            end)

            if ok and typeof(conns) == "table" then
                for _, c in ipairs(conns) do
                    local fn = c.Function

                    if typeof(fn) == "function" and not seen[fn] then
                        seen[fn] = true
                        table.insert(fns, fn)
                    end
                end
            end
        end
    end

    return fns
end

local function StaminaTick(fns)
    for _, fn in ipairs(fns) do
        local ups = GetUpvalues(fn)
        local st = ST.stats[fn]

        if not st then
            st = {}
            ST.stats[fn] = st
        end

        if ST.index > 0 then
            -- กำหนดตำแหน่งเอง (เหมือนสคริปต์เดิมที่ใช้ตำแหน่ง 6)
            local v = ups[ST.index]

            if typeof(v) == "number" and v < ST.max then
                pcall(dbg.setupvalue, fn, ST.index, ST.max)
            end
        else
            for idx, v in pairs(ups) do
                if typeof(v) == "number" then
                    if v < 0 or v > ST.max then
                        st[idx] = nil
                    else
                        local e = st[idx]

                        if not e then
                            st[idx] = {last = v, seenMax = v, changes = 0, decreases = 0, locked = false}
                        else
                            if v ~= e.last then
                                e.changes += 1

                                if v < e.last then
                                    e.decreases += 1
                                end

                                e.last = v
                            end

                            if v > e.seenMax then
                                e.seenMax = v
                            end

                            -- ตัวแปรที่ขึ้นลงในช่วง 0..max และเคยลดลง = น่าจะเป็นสเตมิน่า
                            if not e.locked
                                and e.changes >= 2
                                and e.decreases >= 1
                                and e.seenMax >= ST.max * 0.9 then

                                e.locked = true

                                if StaminaOnLock then
                                    StaminaOnLock(idx)
                                end
                            end

                            if e.locked and v < ST.max then
                                pcall(dbg.setupvalue, fn, idx, ST.max)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function StopStamina()
    StaminaToken += 1
    ST.stats = setmetatable({}, {__mode = "k"})

    for inst, bucket in pairs(StaminaEntries) do
        for _, entry in pairs(bucket) do
            if entry.conn then
                entry.conn:Disconnect()
            end
        end

        StaminaEntries[inst] = nil
    end
end

-- คืน (จำนวนฟังก์ชันของปุ่มวิ่งที่พบ, จำนวนค่า Attribute/Value ที่ล็อกอยู่)
local function StartStamina()
    StopStamina()

    local token = StaminaToken
    local fns = {}

    if StaminaSupported() then
        local ok, res = pcall(CollectRunFunctions)

        if ok then
            fns = res
        end
    end

    pcall(ScanStamina)

    task.spawn(function()
        local lastScan = os.clock()

        while StaminaToken == token do
            -- สแกนซ้ำทุก 2 วินาที เผื่อตัวละครเกิดใหม่ / เกมสร้างปุ่มหรือค่าทีหลัง
            if os.clock() - lastScan >= 2 then
                lastScan = os.clock()
                pcall(ScanStamina)

                if StaminaSupported() then
                    local ok, res = pcall(CollectRunFunctions)

                    if ok then
                        fns = res
                    end
                end
            end

            if #fns > 0 then
                pcall(StaminaTick, fns)
            end

            task.wait(0.05)
        end
    end)

    return #fns, CountStamina()
end

-- ========== Auto Farm (ฟาร์มงานอัตโนมัติ) ==========
-- พอร์ตมาจากสคริปต์ NEXUS X HUB (แมพ "สายเลือดอาชีวะ")
-- เดินล้วนด้วย Pathfinding: ไม่วาร์ป ไม่ทะลุกำแพง ไม่เร่งความเร็ว + เล่นมินิเกม/ขายของให้อัตโนมัติ
-- ใช้ได้เฉพาะแมพที่มีโฟลเดอร์ Workspace.Job.* และ UI ชื่อเดียวกับแมพนั้น
local FarmAPI = {}

do
    local UserInputService = game:GetService("UserInputService")
    local PathfindingService = game:GetService("PathfindingService")
    local VIM
    pcall(function() VIM = game:GetService("VirtualInputManager") end)

    local notifyFn
    local function notify(title, content, icon, dur)
        if notifyFn then
            notifyFn(title, content, icon, dur)
        end
    end

    local function getHum()
        local c = LocalPlayer.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end

    local function getRoot()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local Farm = {
        On = false, Job = "ทำความสะอาด", Delay = 0.6, Visited = {}, Count = 0,
        Skip = {}, Fail = {}, Log = {}, SnapPts = {},
        Snaps = 0, Pulls = 0, ConsecFail = 0,
        Range = 250, ManualWalk = false,
        Phase = "idle", Target = nil, TripStart = nil, Started = 0, IgnoreUntil = 0,
        AutoMiniGame = true, AutoSell = true, Sprint = true, AvoidWalls = true,
        Rest = 5, PendingRest = false,
    }

    local FARM_JOBS = {
        ["ทำความสะอาด"] = { path = { "Job", "ทำความสะอาด" } },
        ["เก็บขยะ + ขาย"] = { path = { "Job", "ขยะ" }, sellEvery = 5 },
        ["งานก่อสร้าง"] = { path = { "Job", "งานก่อสร้าง" }, collectEvery = 8,
            collect = { gui = "ConstructionUI", btn = { "MainFrame", "WorkPage", "BtnRow", "CollectBtn" } } },
        ["ซ่อมรถ"] = { path = { "Job", "ซ่อมรถ" }, collectEvery = 8,
            collect = { gui = "mechanicUI", btn = { "MainFrame", "WorkPage", "BtnRow", "CollectBtn" } } },
    }

    local function farmFolder(job)
        local f = Workspace

        for _, n in ipairs(FARM_JOBS[job].path) do
            f = f and f:FindFirstChild(n)
        end

        return f
    end

    local function promptPos(d)
        local par = d.Parent

        if par and par:IsA("BasePart") then return par.Position end
        if par and par:IsA("Attachment") then return par.WorldPosition end

        local part = d:FindFirstAncestorWhichIsA("BasePart")
        return part and part.Position
    end

    -- หา ProximityPrompt ที่ใกล้ที่สุด kind: "site" = จุดงาน | "npc" = NPC | "sell" = จุดขาย
    local function farmNearest(folder, kind, range)
        local root = getRoot()
        if not (folder and root) then return end

        local best, bestD

        for _, d in ipairs(folder:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Enabled then
                local full = d:GetFullName()
                local isNPC = full:find(".NPC.", 1, true) ~= nil
                local isSell = full:find(".NPC.Sell", 1, true) ~= nil
                local ok = (kind == "site" and not isNPC) or (kind == "npc" and isNPC) or (kind == "sell" and isSell)
                local vis = Farm.Visited[d]
                local skp = Farm.Skip[d]

                if ok and not (vis and os.clock() - vis < 6) and not (skp and os.clock() < skp) then
                    local pos = promptPos(d)

                    if pos then
                        local dist = (pos - root.Position).Magnitude

                        if (not range or dist <= range) and (not bestD or dist < bestD) then
                            best, bestD = d, dist
                        end
                    end
                end
            end
        end

        return best
    end

    local function fmtV(v)
        if not v then return "nil" end
        return string.format("(%.0f, %.0f, %.0f)", v.X, v.Y, v.Z)
    end

    local function farmLog(kind, info)
        local t = Farm.Started > 0 and (os.clock() - Farm.Started) or 0
        local line = string.format("[%6.1fs] %s | %s | %s", t, kind, Farm.Phase, info or "")

        Farm.Log[#Farm.Log + 1] = line

        if #Farm.Log > 80 then
            table.remove(Farm.Log, 1)
        end

        -- แสดงใน Console (F9) ไว้ตามดูว่าแต่ละขั้นทำงานหรือพังตรงไหน
        print("[Flexozy Farm] " .. line)
    end

    -- ตรวจจับการโดนดึงกลับ (ตำแหน่งกระโดดผิดปกติ)
    local farmMon

    local function farmMonitorStop()
        if farmMon then
            farmMon:Disconnect()
            farmMon = nil
        end
    end

    local function farmMonitorStart()
        farmMonitorStop()
        local last

        farmMon = RunService.Heartbeat:Connect(function()
            local r = getRoot()

            if not r then
                last = nil
                return
            end

            local p = r.Position

            if last and os.clock() > Farm.IgnoreUntil then
                local jump = (p - last).Magnitude

                if jump > 25 then
                    Farm.Snaps = Farm.Snaps + 1

                    if #Farm.SnapPts < 200 then
                        Farm.SnapPts[#Farm.SnapPts + 1] = p
                    end

                    local tgt = Farm.Target and promptPos(Farm.Target)
                    local home = Farm.TripStart and (p - Farm.TripStart).Magnitude < 15

                    farmLog("SNAP", string.format("%s -> %s | jump=%.0f | เป้าหมาย=%s | %s",
                        fmtV(last), fmtV(p), jump, fmtV(tgt), home and "กลับจุดเริ่มต้นของทริป" or "ไปที่อื่น"))
                end
            end

            last = p
        end)
    end

    local function farmFailed(d, why, tries)
        Farm.Fail[d] = tries + 1
        Farm.Pulls = Farm.Pulls + 1
        Farm.Skip[d] = os.clock() + math.min(10 * (tries + 1), 40)
        farmLog("FAIL", why .. " | ครั้งที่ " .. (tries + 1) .. " | " .. d:GetFullName())
        Farm.Phase = "idle"

        return false
    end

    local function farmActive()
        return Farm.On or Farm.ManualWalk
    end

    -- กด/ปล่อย Shift ให้เหมือนเรากดวิ่งเอง (ใช้ตอนเดินไปจุดงานเท่านั้น)
    local sprinting = false

    local function setSprint(on)
        if on and not Farm.Sprint then
            on = false
        end

        if on == sprinting then return end
        sprinting = on

        local ok = false

        if VIM then
            ok = pcall(function()
                VIM:SendKeyEvent(on, Enum.KeyCode.LeftShift, false, game)
            end)
        end

        if not ok then
            -- วิธีสำรอง: คีย์บอร์ดจำลองของ executor (0x10 = Shift)
            if on and keypress then
                pcall(keypress, 0x10)
            elseif not on and keyrelease then
                pcall(keyrelease, 0x10)
            end
        end
    end

    -- ===== เดินด้วย Pathfinding (เหมือนสคริปต์ต้นฉบับ) =====
    -- Pathfinding คำนวณเส้นทางบน navmesh จึงอ้อมกำแพงให้อยู่แล้ว
    -- เพิ่มเฉพาะ: ถ้าติดจริง (แทบไม่ขยับ) จะกระโดดแล้วคำนวณเส้นทางใหม่จากตำแหน่งปัจจุบัน (เปิด/ปิดด้วย "หลบกำแพง")
    local function farmWalkInner(pos, stop)
        stop = stop or 4
        local hum, root = getHum(), getRoot()
        if not (hum and root) then return false end

        local t0 = os.clock()
        local limit = (pos - root.Position).Magnitude / math.max(hum.WalkSpeed, 12) * 2.5 + 10

        while farmActive() and hum.WalkSpeed <= 0 and os.clock() - t0 < 8 do
            task.wait(0.2)
        end

        local snaps0 = Farm.Snaps

        local function flatDist()
            local r = getRoot()
            return r and Vector3.new(pos.X - r.Position.X, 0, pos.Z - r.Position.Z).Magnitude or math.huge
        end

        local function alive()
            return farmActive() and getHum() and getRoot() and Farm.Snaps == snaps0 and os.clock() - t0 < limit
        end

        local attempts = 0

        while alive() and flatDist() > stop and attempts < 3 do
            attempts += 1

            local waypoints
            local okp, path = pcall(function()
                local pth = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
                pth:ComputeAsync(getRoot().Position, pos)
                return pth
            end)

            if okp and path and path.Status == Enum.PathStatus.Success then
                waypoints = path:GetWaypoints()
            end

            local repath = false

            if waypoints then
                for _, wp in ipairs(waypoints) do
                    if not alive() or flatDist() <= stop then break end

                    local h = getHum()

                    if wp.Action == Enum.PathWaypointAction.Jump then
                        h.Jump = true
                    end

                    h:MoveTo(wp.Position)

                    local t1 = os.clock()
                    local lastPos = getRoot().Position
                    local lastMove = os.clock()

                    while alive() and flatDist() > stop and os.clock() - t1 < 4
                        and Vector3.new(wp.Position.X - getRoot().Position.X, 0, wp.Position.Z - getRoot().Position.Z).Magnitude > 3 do
                        task.wait(0.1)

                        local r = getRoot()

                        if r and (r.Position - lastPos).Magnitude > 1 then
                            lastPos = r.Position
                            lastMove = os.clock()
                        elseif Farm.AvoidWalls and os.clock() - lastMove > 1.5 then
                            -- ติดจริง: กระโดดแล้วไปคำนวณเส้นทางใหม่
                            local hh = getHum()

                            if hh then
                                hh.Jump = true
                            end

                            repath = true
                            break
                        end
                    end

                    if repath then break end
                end
            end

            if not repath then break end
        end

        local lastMove = 0

        while alive() and flatDist() > stop do
            if os.clock() - lastMove > 1 then
                getHum():MoveTo(pos)
                lastMove = os.clock()
            end

            task.wait(0.1)
        end

        return flatDist() <= stop + 2
    end

    -- ครอบด้วย pcall เพื่อให้ปล่อย Shift เสมอ แม้ระหว่างเดินเกิด error
    local function farmWalk(pos, stop)
        setSprint(true)

        local ok, res = pcall(farmWalkInner, pos, stop)

        setSprint(false)

        if not ok then
            warn("[Flexozy Farm] เดินผิดพลาด: " .. tostring(res))
            return false
        end

        return res
    end

    local function miniGameOpen()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local g = pg and pg:FindFirstChild("MiniGameUI")

        return g ~= nil and g.Enabled
    end

    -- เดินไปหาจุดแล้วกด ProximityPrompt
    local function farmUse(d)
        local pos = promptPos(d)
        local root = getRoot()
        if not (pos and root) then return false end

        local start = root.Position
        local maxDist = math.max(tonumber(d.MaxActivationDistance) or 10, 8)
        local tries = Farm.Fail[d] or 0

        Farm.Target, Farm.TripStart = d, start
        Farm.Phase = "walk"

        local stopAt = math.max(maxDist - 4, 4)
        local flat = Vector3.new(pos.X - start.X, 0, pos.Z - start.Z).Magnitude

        if flat > stopAt then
            farmLog("WALK", string.format("เดินจาก %s ไป %s | ระยะ=%.0f", fmtV(start), fmtV(pos), (pos - start).Magnitude))
            farmWalk(pos, stopAt)
        end

        root = getRoot()

        if not root then
            Farm.Phase = "idle"
            return false
        end

        local here = root.Position
        local dist3 = (pos - here).Magnitude

        if dist3 > maxDist + 6 then
            return farmFailed(d, string.format("เดินไปไม่ถึง (ห่าง %.0f อยู่ที่ %s)", dist3, fmtV(here)), tries)
        end

        Farm.Phase = "action"
        Farm.Visited[d] = os.clock()
        farmLog("PRESS", string.format("กดงาน %s | hold=%.1f", d:GetFullName(), math.max(d.HoldDuration, 0)))

        local hold = math.max(d.HoldDuration, 0)
        local total = hold + Farm.Delay

        if fireproximityprompt then
            pcall(fireproximityprompt, d)
        else
            pcall(function() d:InputHoldBegin() end)
            total = total + math.max(hold, 0.1) + 0.1
        end

        local t0, pulled = os.clock(), false

        while os.clock() - t0 < total and Farm.On do
            local r = getRoot()

            if r and (r.Position - here).Magnitude >= 40 then
                pulled = true
                break
            end

            task.wait(0.05)
        end

        if not fireproximityprompt then
            pcall(function() d:InputHoldEnd() end)
        end

        if pulled then
            local r = getRoot()
            return farmFailed(d, "โดนดึงกลับระหว่างทำงาน (อยู่ที่ " .. fmtV(r and r.Position) .. ")", tries)
        end

        Farm.Fail[d] = 0
        Farm.Phase = "idle"

        return true
    end

    -- ===== ตัวช่วย GUI / อินพุต =====

    local function farmGui(name)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        return pg and pg:FindFirstChild(name)
    end

    local function farmFindPath(root, path)
        local o = root

        for _, n in ipairs(path) do
            o = o and o:FindFirstChild(n)
        end

        return o
    end

    local function farmWaitGuiClosed(name, timeout)
        local t0 = os.clock()
        local g = farmGui(name)

        while Farm.On and g and g.Enabled and os.clock() - t0 < (timeout or 90) do
            task.wait(0.5)
        end
    end

    -- กดปุ่มด้วย firesignal (ถ้ามี) ไม่งั้นใช้วิธีสำรอง
    local function fsig(btn)
        if firesignal then
            pcall(firesignal, btn.MouseButton1Click)
            pcall(firesignal, btn.MouseButton1Down)
            pcall(firesignal, btn.MouseButton1Up)
            return
        end

        local det = btn:FindFirstChildOfClass("ClickDetector")

        if det and fireclickdetector then
            pcall(fireclickdetector, det)
            return
        end

        pcall(function() btn:Activate() end)
    end

    local function centerOf(gui)
        return gui.AbsolutePosition + gui.AbsoluteSize * 0.5
    end

    local function moveMouseTo(x, y)
        local tx, ty = x, y

        for _ = 1, 4 do
            local sent = false

            if VIM then
                sent = pcall(function() VIM:SendMouseMoveEvent(tx, ty, game) end)
            end

            if not sent and mousemoveabs then
                pcall(mousemoveabs, tx, ty)
            end

            task.wait(0.06)

            local loc = UserInputService:GetMouseLocation()
            local dx, dy = x - loc.X, y - loc.Y

            if math.abs(dx) < 4 and math.abs(dy) < 4 then
                return true, tx - x, ty - y
            end

            tx, ty = tx + dx, ty + dy
        end

        return false, tx - x, ty - y
    end

    local function sendMove(x, y)
        local sent = false

        if VIM then
            sent = pcall(function() VIM:SendMouseMoveEvent(x, y, game) end)
        end

        if not sent and mousemoveabs then
            pcall(mousemoveabs, x, y)
        end
    end

    local function mouseHold(down)
        local loc = UserInputService:GetMouseLocation()

        if VIM then
            pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, down, game, 0) end)
        end

        if down then
            if mouse1press then pcall(mouse1press) end
        else
            if mouse1release then pcall(mouse1release) end
        end
    end

    local function clickBtn(btn)
        if firesignal then
            pcall(firesignal, btn.MouseButton1Click)
            return
        end

        if getconnections then
            pcall(function()
                for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                    c:Fire()
                end
            end)
            return
        end

        pcall(function() btn:Activate() end)
    end

    local function mgAlive(g, frame)
        return Farm.On and g and g.Enabled and frame and frame.Visible
    end

    -- ===== มินิเกมอัตโนมัติ =====

    local function isLit(btn)
        local c = btn.BackgroundColor3
        return c.R > 0.85 and c.G > 0.7 and c.B < 0.4
    end

    local function solveNail(g)
        local frame = g:FindFirstChild("NailFrame")
        if not (frame and frame.Visible) then return false end

        notify("มินิเกม", "🔨 ตอกตะปู — กำลังทำอัตโนมัติ", "zap", 2)

        local t0 = os.clock()

        while mgAlive(g, frame) and os.clock() - t0 < 45 do
            local hit = false

            for i = 1, 4 do
                local btn = frame:FindFirstChild("NailBtn" .. i)

                if btn and isLit(btn) then
                    task.wait(0.1)

                    if isLit(btn) then
                        clickBtn(btn)
                        hit = true
                        task.wait(0.45)
                        break
                    end
                end
            end

            if not hit then
                task.wait(0.05)
            end
        end

        return true
    end

    local function solveHold(g, frameName, btnName, label)
        local frame = g:FindFirstChild(frameName)
        if not (frame and frame.Visible) then return false end

        notify("มินิเกม", label .. " — กดเมาส์ค้างอัตโนมัติ (~8 วิ)", "zap", 3)

        local btn = frame:FindFirstChild(btnName)

        if btn then
            local c = centerOf(btn)
            moveMouseTo(c.X, c.Y)
        end

        mouseHold(true)

        local t0, lastPress = os.clock(), os.clock()

        while mgAlive(g, frame) and os.clock() - t0 < 30 do
            if os.clock() - lastPress > 1 and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                mouseHold(true)
                lastPress = os.clock()
            end

            task.wait(0.1)
        end

        mouseHold(false)

        return true
    end

    local function solveSweep(g, frameName)
        local frame = g:FindFirstChild(frameName)
        if not (frame and frame.Visible) then return false end

        local floorBg = frame:FindFirstChild("FloorBg")
        if not floorBg then return true end

        notify("มินิเกม", "🧹 กวาดพื้น — กำลังทำอัตโนมัติ", "zap", 2)

        local catcher = floorBg:FindFirstChild("_InputCatcher")
        local w0 = os.clock()

        while not catcher and os.clock() - w0 < 2 do
            task.wait(0.1)
            catcher = floorBg:FindFirstChild("_InputCatcher")
        end

        local ctr = centerOf(floorBg)
        local sz = floorBg.AbsoluteSize
        local _, ox, oy = moveMouseTo(ctr.X, ctr.Y)

        local usedSignal = false

        if catcher and firesignal then
            pcall(firesignal, catcher.MouseButton1Down)
            usedSignal = true
        else
            mouseHold(true)
        end

        local rx, ry = sz.X * 0.3, sz.Y * 0.3
        local ang, t0 = 0, os.clock()

        while mgAlive(g, frame) and os.clock() - t0 < 40 do
            ang = ang + 0.25
            sendMove(ctr.X + math.cos(ang) * rx + ox, ctr.Y + math.sin(ang) * ry + oy)
            task.wait()
        end

        if usedSignal then
            pcall(firesignal, catcher.MouseButton1Up)
        else
            mouseHold(false)
        end

        return true
    end

    local function boltDone(btn)
        local fillBg = btn:FindFirstChild("FillBg")
        local fill = fillBg and fillBg:FindFirstChild("Fill")
        return fill and fill.Size.X.Scale >= 0.99
    end

    local function solveWheel(g)
        local frame = g:FindFirstChild("WheelFrame")
        if not (frame and frame.Visible) then return false end

        notify("มินิเกม", "🔩 ขันน็อต — กำลังทำอัตโนมัติ", "zap", 2)

        local t0 = os.clock()

        if firesignal then
            while mgAlive(g, frame) and os.clock() - t0 < 30 do
                for i = 1, 4 do
                    local btn = frame:FindFirstChild("BoltBtn" .. i)

                    if btn and not boltDone(btn) then
                        pcall(firesignal, btn.MouseButton1Down)
                    end
                end

                task.wait(0.25)
            end
        else
            for i = 1, 4 do
                local btn = frame:FindFirstChild("BoltBtn" .. i)

                if btn and mgAlive(g, frame) then
                    local c = centerOf(btn)
                    moveMouseTo(c.X, c.Y)
                    mouseHold(true)

                    local t1 = os.clock()

                    while mgAlive(g, frame) and not boltDone(btn) and os.clock() - t1 < 6 do
                        task.wait(0.1)
                    end

                    mouseHold(false)
                    task.wait(0.1)
                end
            end
        end

        return true
    end

    local function solveTrash(g)
        local frame = g:FindFirstChild("TrashFrame")
        if not (frame and frame.Visible) then return false end

        local dark = frame:FindFirstChild("DarkBox")
        local catcher = dark and dark:FindFirstChild("InputCatcher")
        if not (dark and catcher) then return true end

        notify("มินิเกม", "🔦 ขุดขยะ — กำลังทำอัตโนมัติ (ใช้เวลาราว 8 วิ/จุด)", "zap", 3)
        task.wait(0.35)

        local function targets()
            local list = {}

            for _, c in ipairs(dark:GetChildren()) do
                if c.Name == "Target" and c:IsA("GuiObject") then
                    list[#list + 1] = c
                end
            end

            return list
        end

        local function isFound(t)
            local ic = t:FindFirstChild("Icon")
            return ic ~= nil and ic.ImageColor3.R < 0.7
        end

        local t0 = os.clock()

        while mgAlive(g, frame) and os.clock() - t0 < 110 do
            local pending

            for _, t in ipairs(targets()) do
                if not isFound(t) then
                    pending = t
                    break
                end
            end

            if not pending then break end

            local c = centerOf(pending)
            moveMouseTo(c.X, c.Y)

            if firesignal then
                pcall(firesignal, catcher.MouseButton1Down)
            else
                mouseHold(true)
            end

            local t1 = os.clock()

            while mgAlive(g, frame) and not isFound(pending) and os.clock() - t1 < 13 do
                task.wait(0.1)
            end

            if firesignal then
                pcall(firesignal, catcher.MouseButton1Up)
            else
                mouseHold(false)
            end

            task.wait(0.15)
        end

        return true
    end

    local function autoSolveMiniGame(g)
        -- GUI เปิดก่อนแต่เฟรมของมินิเกมอาจโผล่ช้ากว่าเล็กน้อย: ลองซ้ำจนกว่าจะเจอชนิดที่รองรับ (ไม่ต้องยืนรอ)
        local t0 = os.clock()

        while Farm.On and g.Enabled and os.clock() - t0 < 2.5 do
            if solveNail(g) then return end
            if solveHold(g, "WeldFrame", "WeldBtn", "🔥 เชื่อมโลหะ") then return end
            if solveHold(g, "DrillFrame", "DrillBtn", "⚙️ เจาะพื้น") then return end
            if solveSweep(g, "SweepFrame") then return end
            if solveSweep(g, "Sweep") then return end
            if solveWheel(g) then return end
            if solveTrash(g) then return end

            task.wait(0.1)
        end

        notify("มินิเกมนี้ยังไม่รองรับ", "ทำเองได้เลย ฟาร์มจะรอจนมินิเกมปิด", "triangle-alert", 4)
    end

    -- คืน true ถ้ามีมินิเกมเปิดอยู่และรอจนปิดแล้ว
    local function farmWaitMiniGame()
        local g = farmGui("MiniGameUI")
        if not (g and g.Enabled) then return false end

        if Farm.AutoMiniGame then
            task.spawn(function()
                autoSolveMiniGame(g)
            end)
        end

        local t0 = os.clock()

        while Farm.On and g and g.Enabled and os.clock() - t0 < 130 do
            task.wait(0.1)
        end

        task.wait(0.15)

        return true
    end

    -- ===== ขายของ / รับเงิน =====

    local function autoSell(g)
        local frame = g:FindFirstChild("Frame")
        if not frame then return end

        local inv = frame:FindFirstChild("invantory")
        local itemsScroll = inv and inv:FindFirstChild("Items")
        if not itemsScroll then return end

        local clicked = 0

        for _, child in ipairs(itemsScroll:GetChildren()) do
            if child:IsA("ImageLabel") and child.Visible then
                local cc = child:FindFirstChild("ClickCatcher")

                if cc then
                    fsig(cc)
                    clicked = clicked + 1
                    task.wait(0.06)
                end
            end
        end

        if clicked == 0 then return end

        task.wait(0.3)

        local sellSection = frame:FindFirstChild("Sell")

        if sellSection then
            local sellBtn = sellSection:FindFirstChildOfClass("TextButton")

            if sellBtn then
                fsig(sellBtn)
                task.wait(0.5)
            end
        end
    end

    local function farmWaitSell()
        task.wait(0.8)

        local g = farmGui("Shopsell")
        if not (g and g.Enabled) then return end

        if Farm.AutoSell then
            notify("ขายของอัตโนมัติ", "กำลังเลือกของและกดขายให้...", "coins", 3)
            autoSell(g)
            task.wait(1)

            local frame = g:FindFirstChild("Frame")
            local closeBtn = frame and frame:FindFirstChild("Close")

            if closeBtn then
                fsig(closeBtn)
            end

            task.wait(0.5)
        else
            notify("ขายของเอง", "เลือกของแล้วกดขาย แล้วปิดหน้าต่าง ฟาร์มจะทำต่อเอง", "coins", 5)
            farmWaitGuiClosed("Shopsell", 120)
        end
    end

    local function farmCollect(job)
        local c = job.collect
        local d = farmNearest(farmFolder(Farm.Job), "npc")

        if not d then
            notify("ไม่พบ NPC งาน", "เดินเข้าใกล้โซนงานแล้วลองใหม่", "triangle-alert", 3)
            return false
        end

        if not farmUse(d) then return false end

        local t0 = os.clock()
        local g

        repeat
            task.wait(0.3)
            g = farmGui(c.gui)
        until (g and g.Enabled) or os.clock() - t0 > 6 or not Farm.On

        if not (g and g.Enabled) then
            notify("เปิดหน้างานไม่ได้", "คุยกับ NPC ด้วยตัวเองแล้วกด Collect", "triangle-alert", 4)
            return false
        end

        local wp = farmFindPath(g, { "MainFrame", "WorkPage" })
        local btn = farmFindPath(g, c.btn)
        local closeB = farmFindPath(g, { "MainFrame", "Header", "CloseBtn" })

        if wp and not wp.Visible then
            notify("ยังไม่ได้รับงาน", "คุยกับ NPC แล้วกด 'จ้าง' ก่อน แล้วค่อยเปิดฟาร์ม", "triangle-alert", 5)

            if closeB and firesignal then
                pcall(firesignal, closeB.MouseButton1Click)
            end

            return false
        end

        if btn and firesignal then
            pcall(firesignal, btn.MouseButton1Click)
            task.wait(0.6)

            if closeB then
                pcall(firesignal, closeB.MouseButton1Click)
            end

            return true
        end

        notify("กดรับเงินเอง", "ตัวรันไม่มี firesignal — กด Collect แล้วปิดหน้าต่าง ฟาร์มจะทำต่อเอง", "triangle-alert", 5)
        farmWaitGuiClosed(c.gui, 90)

        return true
    end

    -- สั่งให้ตัวละครหยุดเดิน/วิ่งและยืนอยู่กับที่
    local function standStill()
        local h, r = getHum(), getRoot()

        if h and r then
            pcall(function()
                h:MoveTo(r.Position)
            end)
        end
    end

    -- พักสั้นๆ หลังเสร็จงาน (หยุดทันทีถ้าปิดฟาร์ม)
    local function restWait(sec)
        local t0 = os.clock()

        while Farm.On and os.clock() - t0 < sec do
            task.wait(0.1)
        end
    end

    -- ===== ลูปหลัก =====

    local function farmLoop()
        -- เดินไปรับงานจาก NPC ก่อน
        do
            local npcD = farmNearest(farmFolder(Farm.Job), "npc")

            if npcD then
                local pos = promptPos(npcD)

                if pos then
                    notify("เริ่มฟาร์ม", "กำลังเดินหา NPC รับงานก่อน...", "navigation", 3)
                    Farm.ManualWalk = true
                    farmWalk(pos, 6)
                    Farm.ManualWalk = false

                    farmUse(npcD)
                    task.wait(1)
                end
            else
                notify("ไม่พบ NPC", "หาจุดงานเลยเพราะไม่มี NPC ในระยะ " .. Farm.Range .. " สตัด", "triangle-alert", 3)
            end
        end

        local lastWarn, lastPullWarn = 0, 0

        while Farm.On do
            if not getRoot() then
                task.wait(1)
            else
                local played = farmWaitMiniGame()

                if played then
                    farmLog("GAME", "มินิเกมจบแล้ว")
                end

                -- เสร็จงานแล้ว: พักสักครู่ค่อยวิ่งไปทำงานต่อ
                -- ระหว่างพักถ้ามินิเกมเพิ่งเปิดจะเล่นทันที (ไม่ยืนรอ) แล้วค่อยพักหลังเล่นจบ
                if Farm.PendingRest then
                    Farm.PendingRest = false

                    -- เสร็จงานแล้ว: ยืนนิ่งๆ ก่อน ยังไม่เดินไปรับงานถัดไป
                    standStill()
                    farmLog("REST", string.format("ยืนรอ %.1f วินาที", Farm.Rest))

                    if not played then
                        local t0 = os.clock()

                        while Farm.On and os.clock() - t0 < Farm.Rest do
                            if miniGameOpen() then
                                played = farmWaitMiniGame() or played
                                break
                            end

                            task.wait(0.1)
                        end
                    end

                    if played then
                        standStill()
                        restWait(Farm.Rest)
                    end
                end

                local job = FARM_JOBS[Farm.Job]
                local folder = farmFolder(Farm.Job)
                local d

                if job.sellEvery and Farm.Count >= job.sellEvery then
                    d = farmNearest(folder, "sell", Farm.Range)

                    if d and farmUse(d) then
                        Farm.Count = 0
                        farmWaitSell()
                        Farm.PendingRest = true
                    end

                    if not d then
                        Farm.Count = 0
                    end
                elseif job.collectEvery and Farm.Count >= job.collectEvery then
                    if farmCollect(job) then
                        Farm.PendingRest = true
                    end

                    Farm.Count = 0
                else
                    d = folder and farmNearest(folder, "site", Farm.Range)

                    if d then
                        if farmUse(d) then
                            Farm.Count = Farm.Count + 1
                            Farm.ConsecFail = 0
                            Farm.PendingRest = true
                        else
                            Farm.ConsecFail = Farm.ConsecFail + 1

                            if Farm.ConsecFail >= 3 and os.clock() - lastPullWarn > 15 then
                                lastPullWarn = os.clock()
                                notify("โดนดึงกลับบ่อย", "ฟาร์มจะข้ามจุดที่มีปัญหาชั่วคราว", "triangle-alert", 5)
                            end
                        end
                    elseif os.clock() - lastWarn > 12 then
                        lastWarn = os.clock()
                        notify("ไม่พบจุดงานในระยะ " .. Farm.Range .. " สตัด", "เดินเข้าใกล้โซนงาน (หรือจุดถูกข้ามชั่วคราว)", "triangle-alert", 4)
                    end
                end

                task.wait(Farm.PendingRest and 0.05 or math.min(0.2 + Farm.ConsecFail * 0.3, 3))
            end
        end

        Farm.Phase = "idle"
    end

    -- ===== ส่วนที่ UI เรียกใช้ =====

    FarmAPI.Farm = Farm

    FarmAPI.JobNames = {}

    for k in pairs(FARM_JOBS) do
        table.insert(FarmAPI.JobNames, k)
    end

    table.sort(FarmAPI.JobNames)

    function FarmAPI.SetNotify(fn)
        notifyFn = fn
    end

    function FarmAPI.SetJob(name)
        if FARM_JOBS[name] then
            Farm.Job = name
            Farm.Visited, Farm.Skip, Farm.Fail = {}, {}, {}
            Farm.Count = 0
        end
    end

    function FarmAPI.StopSprint()
        setSprint(false)
    end

    function FarmAPI.Start()
        if Farm.On then return end

        Farm.On = true

        if not fireproximityprompt then
            notify("ตัวรันไม่รองรับ", "ไม่มี fireproximityprompt จะใช้วิธีสำรองแทน", "triangle-alert", 3)
        end

        Farm.Visited, Farm.Skip, Farm.Fail = {}, {}, {}
        Farm.ConsecFail = 0
        Farm.PendingRest = false
        Farm.Started = os.clock()
        farmMonitorStart()
        task.spawn(farmLoop)
    end

    function FarmAPI.Stop()
        Farm.On = false
        Farm.ManualWalk = false
        farmMonitorStop()
        setSprint(false)

        -- สั่งหยุดเดิน
        local hum = getHum()
        local root = getRoot()

        if hum and root then
            pcall(function() hum:MoveTo(root.Position) end)
        end
    end
end

